# ─── Obrigatórias ───────────────────────────────────────────────────────────
# O servidor recusa subir (assertRequiredEnv) se qualquer uma faltar.

# Conexão MySQL/TiDB.
DATABASE_URL=mysql://usuario:senha@host:3306/defocus

# URL pública canônica da aplicação, sem barra no final.
#
# SEGURANÇA: é a ÚNICA origem admitida para montar links que carregam
# credencial (redefinição de senha). Já foi um parâmetro enviado pelo cliente,
# o que permitia a qualquer pessoa fazer o app enviar um e-mail legítimo com um
# token válido apontando para um domínio hostil — tomada de conta em uma única
# requisição. Nunca derive esta URL do corpo da requisição nem dos cabeçalhos
# Host, Origin ou Referer.
APP_PUBLIC_URL=https://defocus.personalphaco.com

# ─── Sessão ─────────────────────────────────────────────────────────────────

# Segredo de assinatura dos cookies de sessão (JWT). OBRIGATÓRIO, mínimo 32
# caracteres — o servidor recusa subir sem ele. Gere com: openssl rand -base64 48
JWT_SECRET=

# ─── E-mail transacional (Resend) ───────────────────────────────────────────
# Sem esta chave o envio é silenciosamente ignorado: sendEmail apenas registra
# um aviso e retorna false. É o motivo de a recuperação de senha não funcionar
# hoje em produção.
#
# ATENÇÃO: só religue o envio depois de confirmar que a correção do
# APP_PUBLIC_URL está em produção. Com o e-mail desligado, a falha de tomada de
# conta era inexplorável; religar antes de corrigir a torna explorável.
RESEND_API_KEY=

# ─── Conta dona ─────────────────────────────────────────────────────────────
# openId da conta que nasce administradora. Contas de e-mail usam "email:<endereço>".
OWNER_OPEN_ID=email:renato@personalphaco.com

# ─── Opcionais ──────────────────────────────────────────────────────────────
# PORT=8080                       # a hospedagem normalmente define
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium   # a imagem Docker já define
